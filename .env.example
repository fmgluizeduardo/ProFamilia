# String de conexão do banco PostgreSQL (Neon).
# Use a "Pooled connection" do painel do Neon — ela aguenta os acessos
# simultâneos do site publicado na Vercel.
# Exemplo:
# DATABASE_URL="postgresql://usuario:senha@ep-xxxx-xxxx-pooler.sa-east-1.aws.neon.tech/profamilia?sslmode=require"
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# Segurança do seed de demonstração (nunca rode o seed na produção):
# CONFIRM_SEED_DESTROY=
